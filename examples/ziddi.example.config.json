{
  "schema_version": 1,
  "timezone": "UTC",
  "quiet_hours": {"enabled": true, "start": "00:00", "end": "06:00", "batch_at": "06:00"},
  "active_window_minutes": 30,
  "topics": {
    "money": {"invoice": 2, "contract": 3, "renewal": 3},
    "suppress": [{"keywords": ["newsletter"], "why": "you asked not to be nagged about newsletters"}]
  },
  "signals": [
    {"adapter": "items", "path": "items.example.json", "name": "your task list"},
    {"adapter": "jobs", "path": "jobs.example.json", "name": "background jobs"},
    {"adapter": "conversation", "path": "conversation.example.jsonl", "name": "conversation log"},
    {"adapter": "ics", "path": "calendar.example.ics", "name": "calendar file"}
  ],
  "known_logs": ["sent_log.example.jsonl"],
  "delivery": {"adapter": "stdout"}
}
